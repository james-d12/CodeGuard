{
  "stryker-config": {
    "solution": "CodeGuard.sln",
    "reporters": ["progress", "html", "json"],
    "mutate": ["**/*.cs", "!tests/CodeGuard.IntegrationTests/**/*.cs"],
    "test-projects": [
      "tests/CodeGuard.Cli.Tests"
    ],
    "configuration": "Release",
    "target-framework": "net10",
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 0
    },
    "ignore-methods": [
      "Console.Write*",
      "_logger.Log*"
    ]
  }
}
