<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Locator" Version="1.11.2" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.6.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.6.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- Required by Microsoft.Build.Locator (MSBL001): Microsoft.Build is referenced directly for
         Microsoft.Build.Evaluation.Project (raw project evaluation - see MsBuildAnalysisProvider),
         and Microsoft.Build.Framework comes in transitively via Microsoft.CodeAnalysis.Workspaces.MSBuild.
         Both must exclude runtime assets so the locator's redirected assemblies are used instead. -->
    <PackageReference Include="Microsoft.Build" Version="17.11.48" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Framework" Version="17.11.48" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodeGuard.Analysis\CodeGuard.Analysis.csproj" />
    <ProjectReference Include="..\CodeGuard.Analyzers.Roslyn\CodeGuard.Analyzers.Roslyn.csproj" />
  </ItemGroup>

</Project>
