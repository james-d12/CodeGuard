{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeguard.internal/schemas/validation-report.v1.schema.json",
  "title": "CodeGuard validation report (v1)",
  "description": "Output of `codeguard validate --format json`. schemaVersion identifies this contract; a breaking change to the shape requires a new major schema version.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "toolVersion",
    "status",
    "evaluatedAtUtc",
    "durationMs",
    "metrics",
    "violations",
    "evaluationErrors",
    "analysisWarnings"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0",
      "description": "Version of this result contract."
    },
    "toolVersion": {
      "type": "string",
      "minLength": 1,
      "description": "Version of the CodeGuard CLI that produced the report, without any build-metadata suffix."
    },
    "status": {
      "type": "string",
      "enum": ["passed", "failed", "partiallyEvaluated"],
      "description": "passed: no violations reported and no evaluation errors. failed: at least one violation reported and no evaluation errors. partiallyEvaluated: at least one rule threw during evaluation, so results are incomplete."
    },
    "evaluatedAtUtc": {
      "type": "string",
      "format": "date-time",
      "description": "When rule evaluation completed, ISO 8601 with offset."
    },
    "durationMs": {
      "type": "integer",
      "minimum": 0,
      "description": "Wall-clock milliseconds from the start of the validate command until the report is written. Zero when the producer did not measure it."
    },
    "metrics": { "$ref": "#/$defs/metrics" },
    "violations": {
      "type": "array",
      "items": { "$ref": "#/$defs/violation" }
    },
    "evaluationErrors": {
      "type": "array",
      "items": { "$ref": "#/$defs/evaluationError" }
    },
    "analysisWarnings": {
      "type": "array",
      "items": { "$ref": "#/$defs/analysisWarning" }
    },
    "repository": {
      "type": "string",
      "minLength": 1,
      "description": "Normalised remote URL of the analysed repository, with any credentials or userinfo removed. Omitted when unknown."
    },
    "commit": {
      "type": "string",
      "minLength": 1,
      "description": "Commit SHA of the analysed checkout. Omitted when unknown."
    },
    "branch": {
      "type": "string",
      "minLength": 1,
      "description": "Branch of the analysed checkout. Omitted when unknown (for example a detached HEAD outside CI)."
    },
    "ruleSources": {
      "type": "array",
      "items": { "$ref": "#/$defs/ruleSetSource" },
      "description": "Rule sets the run was evaluated against. Omitted when the producer did not record rule-source provenance."
    }
  },
  "$defs": {
    "severity": {
      "type": "string",
      "enum": ["info", "warning", "error", "critical"]
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rulesEvaluated",
        "rulesPassed",
        "rulesFailed",
        "rulesErrored",
        "violationCount",
        "violationsBySeverity",
        "evaluationErrorCount",
        "analysisWarningCount"
      ],
      "properties": {
        "rulesEvaluated": { "type": "integer", "minimum": 0 },
        "rulesPassed": { "type": "integer", "minimum": 0 },
        "rulesFailed": { "type": "integer", "minimum": 0 },
        "rulesErrored": { "type": "integer", "minimum": 0 },
        "violationCount": { "type": "integer", "minimum": 0 },
        "violationsBySeverity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["info", "warning", "error", "critical"],
          "properties": {
            "info": { "type": "integer", "minimum": 0 },
            "warning": { "type": "integer", "minimum": 0 },
            "error": { "type": "integer", "minimum": 0 },
            "critical": { "type": "integer", "minimum": 0 }
          }
        },
        "evaluationErrorCount": { "type": "integer", "minimum": 0 },
        "analysisWarningCount": { "type": "integer", "minimum": 0 }
      }
    },
    "violation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleId", "ruleVersion", "severity", "message", "documentationReferences"],
      "properties": {
        "ruleId": { "type": "string", "minLength": 1 },
        "ruleVersion": { "type": "integer", "minimum": 1 },
        "severity": { "$ref": "#/$defs/severity" },
        "message": { "type": "string" },
        "file": { "type": "string", "description": "Repository-relative or absolute file path, when known." },
        "line": { "type": "integer", "minimum": 0, "description": "1-based line; 0 when the location is unknown." },
        "column": { "type": "integer", "minimum": 0, "description": "1-based column; 0 when the location is unknown." },
        "endLine": { "type": "integer", "minimum": 1, "description": "1-based line of the end of the violation's span. Present only when the producer knows the span." },
        "endColumn": { "type": "integer", "minimum": 1, "description": "1-based column just past the end of the span (exclusive, SARIF endColumn semantics). Present only with endLine." },
        "metadata": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "Free-form string key/value details attached by the producer. Omitted when there are none."
        },
        "symbol": { "type": "string" },
        "project": { "type": "string" },
        "remediation": { "type": "string" },
        "documentationReferences": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "evaluationError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleId", "exceptionType", "message"],
      "properties": {
        "ruleId": { "type": "string", "minLength": 1 },
        "exceptionType": { "type": "string" },
        "message": { "type": "string" },
        "stackTrace": { "type": "string" }
      }
    },
    "analysisWarning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string" },
        "project": { "type": "string" },
        "filePath": { "type": "string" }
      }
    },
    "ruleSetSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "location"],
      "properties": {
        "kind": { "type": "string", "enum": ["git", "directory"] },
        "location": { "type": "string", "minLength": 1, "description": "Normalised git URL (credentials removed) or local directory path." },
        "commit": { "type": "string", "minLength": 1, "description": "HEAD of the rules cache for git sources. Omitted for directories and when unknown." }
      }
    }
  }
}
