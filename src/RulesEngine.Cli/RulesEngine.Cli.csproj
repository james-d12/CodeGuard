<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <RootNamespace>RulesEngine.Cli</RootNamespace>
        <AssemblyName>rules-engine</AssemblyName>
        <IsPublishable>true</IsPublishable>
    </PropertyGroup>

    <!-- dotnet tool packaging: `dotnet tool install -g RulesEngine` installs the `rules-engine` command. -->
    <!-- Version is derived from git tags (e.g. v0.1.0) by MinVer below - do not add a <Version> property. -->
    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>rules-engine</ToolCommandName>
        <PackageId>RulesEngine.NET</PackageId>
        <Description>Deterministic analysis/validation engine for enforcing engineering standards (DDD, architecture layering, C# conventions) against .NET repositories.</Description>
        <PackageTags>dotnet-tool;static-analysis;roslyn;ddd;architecture;code-quality</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <MinVerTagPrefix>v</MinVerTagPrefix>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\RulesEngine.Core\RulesEngine.Core.csproj" />
        <ProjectReference Include="..\RulesEngine.RuleModel\RulesEngine.RuleModel.csproj" />
        <ProjectReference Include="..\RulesEngine.Analysis\RulesEngine.Analysis.csproj" />
        <ProjectReference Include="..\RulesEngine.Evaluation\RulesEngine.Evaluation.csproj" />
        <ProjectReference Include="..\RulesEngine.Reporting\RulesEngine.Reporting.csproj" />
        <ProjectReference Include="..\RulesEngine.Configuration\RulesEngine.Configuration.csproj" />
        <ProjectReference Include="..\RulesEngine.Analyzers.MSBuild\RulesEngine.Analyzers.MSBuild.csproj" />
        <ProjectReference Include="..\RulesEngine.Analyzers.Repository\RulesEngine.Analyzers.Repository.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="System.CommandLine" Version="3.0.0-preview.6.26359.118" />
      <PackageReference Include="MinVer" Version="7.0.0" PrivateAssets="All" />
    </ItemGroup>

    <ItemGroup>
      <None Include="..\..\README.md" Pack="true" PackagePath="README.md" />
    </ItemGroup>

</Project>
