<Project>

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
    </PropertyGroup>

    <!-- Packaging defaults: nothing is packable by default so `dotnet pack` on the solution -->
    <!-- doesn't publish internal library projects as their own NuGet packages. RulesEngine.Cli -->
    <!-- opts back in explicitly. -->
    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <Authors>james</Authors>
        <Copyright>Copyright 2026 james</Copyright>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/james-d12/RuleEngine</PackageProjectUrl>
        <RepositoryUrl>https://github.com/james-d12/RuleEngine</RepositoryUrl>
    </PropertyGroup>

</Project>
